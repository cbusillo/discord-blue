{
  "description": "Mirror this Claude Code session into its Discord Blue thread through the dui channel server.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dui:dui",
            "tool": "dui_hook_event",
            "input": {
              "event": "SessionStart",
              "session_id": "${session_id}",
              "session_title": "${session_title}",
              "transcript_path": "${transcript_path}"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear|resume",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dui:dui",
            "tool": "dui_hook_event",
            "input": {
              "event": "SessionEnd",
              "session_id": "${session_id}"
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dui:dui",
            "tool": "dui_hook_event",
            "input": {
              "event": "UserPromptSubmit",
              "session_id": "${session_id}",
              "session_title": "${session_title}",
              "prompt": "${prompt}",
              "prompt_id": "${prompt_id}",
              "transcript_path": "${transcript_path}"
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dui:dui",
            "tool": "dui_hook_event",
            "input": {
              "event": "PreToolUse",
              "session_id": "${session_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_use_id": "${tool_use_id}"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dui:dui",
            "tool": "dui_hook_event",
            "input": {
              "event": "PostToolUse",
              "session_id": "${session_id}",
              "tool_use_id": "${tool_use_id}"
            }
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dui:dui",
            "tool": "dui_hook_event",
            "input": {
              "event": "PostToolUseFailure",
              "session_id": "${session_id}",
              "tool_use_id": "${tool_use_id}"
            }
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dui:dui",
            "tool": "dui_hook_event",
            "timeout": 86400,
            "input": {
              "event": "PermissionRequest",
              "session_id": "${session_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "cwd": "${cwd}",
              "prompt_id": "${prompt_id}",
              "transcript_path": "${transcript_path}"
            }
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dui:dui",
            "tool": "dui_hook_event",
            "input": {
              "event": "Notification",
              "session_id": "${session_id}"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dui:dui",
            "tool": "dui_hook_event",
            "input": {
              "event": "Stop",
              "session_id": "${session_id}",
              "last_assistant_message": "${last_assistant_message}",
              "transcript_path": "${transcript_path}"
            }
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dui:dui",
            "tool": "dui_hook_event",
            "input": {
              "event": "StopFailure",
              "session_id": "${session_id}"
            }
          }
        ]
      }
    ]
  }
}
