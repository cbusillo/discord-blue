<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template only. Replace REPO_DIR, HOME_DIR and CODEX_BIN, then load it with launchctl yourself. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shinycomputers.discord-blue-codex-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPO_DIR/.venv/bin/discord-blue-codex-bridge</string>
    <string>--config</string>
    <string>HOME_DIR/.config/discord-blue/codex-bridge.toml</string>
    <string>--supervisor-config</string>
    <string>HOME_DIR/.code/skill-data/supervisor.toml</string>
    <string>--codex-bin</string>
    <string>CODEX_BIN</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPO_DIR</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Native daemons keep this PATH for MCP servers and child tools. Adjust it for your installed tools. -->
    <key>PATH</key>
    <string>HOME_DIR/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>HOME_DIR/Library/Logs/discord-blue-codex-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_DIR/Library/Logs/discord-blue-codex-bridge.log</string>
</dict>
</plist>
