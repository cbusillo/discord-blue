{
  "defaultBranch": "main",
  "projectType": "python-service",
  "docs": {
    "overview": "README.md",
    "agentInstructions": "AGENTS.md",
    "workflow": ".github/workflows/build.yml",
    "packageManifest": "pyproject.toml",
    "lockfile": "uv.lock",
    "dockerfile": "Dockerfile",
    "containerEntrypoint": "docker/entrypoint.sh",
    "gatewayHandover": "discord_blue/gateway_handover.py",
    "dockerignore": ".dockerignore",
    "compose": "docker-compose.yml",
    "runtimeCompose": "compose.runtime.yml",
    "systemdService": "discord-blue.service",
    "bridgeDelivery": "scripts/deliver_bridges.py",
    "bridgeReleaseReconciliation": "scripts/reconcile_bridge_delivery.py",
    "agentSessionProtocol": "docs/agent-session-protocol.md",
    "cmConversation": "docs/cm-conversation.md"
  },
  "qualityGate": {
    "setup": {
      "default": "uv sync --all-groups --python 3.13"
    },
    "format": {
      "check": "uv run ruff format --check .",
      "fix": "uv run ruff format ."
    },
    "lint": {
      "default": "uv run ruff check ."
    },
    "typecheck": {
      "default": "uv run mypy ."
    },
    "test": {
      "default": "uv run python -m unittest discover -s tests -q"
    },
    "build": {
      "docker": "docker build ."
    },
    "json": {
      "metadata": "jq empty .github/github.json"
    },
    "inspection": {
      "ide": "PyCharm",
      "scopePreference": "changed_files",
      "prepare": {
        "python": {
          "version": "3.13",
          "moduleName": "discord-blue",
          "testRoots": ["tests"],
          "sync": true,
          "requiredGeneratedState": [".venv", ".idea"]
        }
      }
    },
    "docsRequiredWhen": [
      "behavior changes",
      "api changes",
      "config changes",
      "Discord command surface changes",
      "Agent session bridge behavior changes",
      "deployment workflow changes",
      "runtime dependency changes",
      "systemd or container wiring changes"
    ]
  },
  "importantWorkflows": [
    "Build",
    "Read Build publication",
    "CodeQL",
    "Dependency Graph",
    "Dependabot Updates"
  ],
  "prWorkflow": {
    "mergePolicy": {
      "method": "merge",
      "requiredStatusChecks": ["ci-gate"],
      "strictStatusChecks": true,
      "requiredApprovals": 0,
      "codeScanning": {
        "ruleset": "Require code scanning results",
        "tool": "CodeQL",
        "alertsThreshold": "errors",
        "securityAlertsThreshold": "high_or_higher"
      }
    },
    "watchSkill": "babysit-pr"
  },
  "relatedRepos": [
    "cbusillo/launchplane"
  ],
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "unavailable",
      "dependabotAlerts": "available",
      "securityAdvisories": "available"
    },
    "refreshWhen": [
      "repo visibility changes",
      "GitHub plan changes",
      "security settings change",
      "token permissions change"
    ]
  },
  "githubSettings": {
    "expected": {
      "deleteBranchOnMerge": true
    }
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true
  },
  "metadataFreshness": {
    "updateWhen": [
      "docs routing changes",
      "validation gates change",
      "primary commands change",
      "important workflows change",
      "branch protection or rulesets change",
      "merge path or policy changes",
      "GitHub signal availability changes",
      "repo relationship changes",
      "cleanup policy changes",
      "deployment workflow changes",
      "Discord command surface changes",
      "Agent session bridge behavior changes",
      "runtime or service wiring changes"
    ]
  }
}
